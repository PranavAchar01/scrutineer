# Python
.venv/
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/
*.egg-info/

# Node
node_modules/
.vercel/

# The scrutineer's signing key. The public key is committed so anyone can verify the chain;
# the private key must not be, or the receipts mean nothing.
scrutineer/loop/lineage/*.key

# Run state. Regenerated by `scrutineer season`; traces and per-span objects are large and
# uninteresting outside the run that produced them.
scrutineer/loop/state/traces/
scrutineer/loop/state/objects/
scrutineer/loop/state/pages/
scrutineer/loop/state/champion/
scrutineer/loop/state/season.json
scrutineer/loop/state/rl_job.json

# Local secrets, in case anyone ever puts one here
.env
.env.*
*.key
!scrutineer/loop/lineage/*.pub
